# Copy to deploy/.env (git-ignored). docker-compose.yml reads it; every value is required.

# Public https URLs, no trailing slash. The proxy in front forwards them to the containers.
API_URL=https://api.example.com
APP_URL=https://app.example.com

# Database password. Avoid ';' — it would break the connection string.
POSTGRES_PASSWORD=CHANGE_ME

# ABP encrypts some stored settings with this. A random 16+ char string; never change it later.
STRING_ENCRYPTION_PASSPHRASE=CHANGE_ME

# The first admin account, created by the migrator on its first run.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Password of certs/openiddict.pfx (the token signing certificate).
OPENIDDICT_CERT_PASSWORD=CHANGE_ME

# Outgoing mail server (booking emails, password resets).
# Port 587 = STARTTLS, use SMTP_ENABLE_SSL=false; port 465 = SSL from the start, use true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENABLE_SSL=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.com
