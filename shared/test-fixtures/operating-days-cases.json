[
  {
    "description": "child is a proper subset of parent",
    "parent": ["Monday", "Tuesday", "Wednesday"],
    "child": ["Monday", "Tuesday"],
    "expected": true
  },
  {
    "description": "child equals parent",
    "parent": ["Monday", "Tuesday", "Wednesday"],
    "child": ["Monday", "Tuesday", "Wednesday"],
    "expected": true
  },
  {
    "description": "child has a day the parent does not allow",
    "parent": ["Monday", "Tuesday", "Wednesday"],
    "child": ["Monday", "Saturday"],
    "expected": false
  },
  {
    "description": "child is every day, parent is not",
    "parent": ["Monday", "Tuesday"],
    "child": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "expected": false
  },
  {
    "description": "parent is every day, child is anything",
    "parent": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "child": ["Saturday"],
    "expected": true
  },
  {
    "description": "empty child is vacuously a subset of any parent",
    "parent": ["Monday"],
    "child": [],
    "expected": true
  }
]
