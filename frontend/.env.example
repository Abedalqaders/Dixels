# OpenIddict client config. Mirrors the "Dixels_App" client registered in
# OpenIddictDataSeedContributor.cs on the backend. Copy to .env.local (gitignored)
# and override per environment — none of these values are secret, they're a
# public SPA client id + URLs, but they differ between local/staging/prod.
VITE_OIDC_AUTHORITY=https://localhost:44334
VITE_OIDC_CLIENT_ID=Dixels_App
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_SCOPE="openid profile email roles Dixels offline_access"
