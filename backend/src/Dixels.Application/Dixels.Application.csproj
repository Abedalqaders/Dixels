<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dixels</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dixels.Domain\Dixels.Domain.csproj" />
    <ProjectReference Include="..\Dixels.Application.Contracts\Dixels.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed only for [HttpGet]/[HttpPost] route attributes on the few app service methods
         whose names don't match ABP's conventional-controller naming guesses (e.g.
         GetResolvedConstraintsAsync, GetTreeAsync). These live in the ASP.NET Core shared
         framework (Microsoft.AspNetCore.Mvc.Core), not a standalone NuGet package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Account.Application" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.Identity.Application" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Application" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.TenantManagement.Application" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Application" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.SettingManagement.Application" Version="10.6.1" />
  </ItemGroup>

</Project>
