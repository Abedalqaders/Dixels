# Copy to backend/.env (git-ignored). docker-compose passes these into the container.
# Every value here is a secret or environment-specific; none of them live in appsettings.json.

# Postgres on the Windows host, reached from the container as host.docker.internal
ConnectionStrings__Default=Host=host.docker.internal;Port=5432;Database=Dixels;User ID=postgres;Password=CHANGE_ME;

# ABP encrypts some stored settings with this. Generate a random 16+ char string and never change it afterwards.
StringEncryption__DefaultPassPhrase=CHANGE_ME

# First admin account (DbMigrator only; used once, when the account is created)
Dixels__AdminEmail=admin@example.com
Dixels__AdminPassword=CHANGE_ME

# true = seed the demo building, bookings and three employee accounts (local only)
Dixels__DemoData=false

# Outside Development the OpenIddict signing certificate is required
# AuthServer__CertificatePath=/https/openiddict.pfx
# AuthServer__CertificatePassword=CHANGE_ME

# Email goes to smtp4dev (started by docker-compose); read it at http://localhost:5000.
# UseDefaultCredentials=true means "don't log in" - smtp4dev has no accounts.
Settings__Abp.Mailing.Smtp.Host=smtp4dev
Settings__Abp.Mailing.Smtp.Port=25
Settings__Abp.Mailing.Smtp.EnableSsl=false
Settings__Abp.Mailing.Smtp.UseDefaultCredentials=true
Settings__Abp.Mailing.DefaultFromAddress=noreply@dixels.local
Settings__Abp.Mailing.DefaultFromDisplayName=Dixels

# HTTPS dev certificate mounted by docker-compose
ASPNETCORE_Kestrel__Certificates__Default__Password=dixels-dev

# Only in a second checkout (git worktree), so it runs next to the first one: its own
# containers and ports. Its web app goes on another port too (npm run dev -- --port 5175);
# the DbMigrator lets ports 5173-5176 sign in (DbMigrator/appsettings.json).
# COMPOSE_PROJECT_NAME=dixels-files
# DIXELS_API_PORT=44336
# DIXELS_MAIL_PORT=5002
# App__SelfUrl=https://localhost:44336
# App__CorsOrigins=http://localhost:5175
# Emails__AppUrl=http://localhost:5175
